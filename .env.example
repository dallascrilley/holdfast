# Copy to .env for local development. These credentials match docker-compose.yml
# and are local-only throwaways; nothing here is a real secret.

# Owns the schema and runs migrations. Application code must never use this.
HOLDFAST_ADMIN_URL=postgres://holdfast_admin:holdfast_admin_local@127.0.0.1:55437/holdfast

# What the application connects as: SELECT and INSERT on the ledger, nothing else.
HOLDFAST_APP_URL=postgres://holdfast_app:holdfast_app_local@127.0.0.1:55437/holdfast
HOLDFAST_APP_ROLE=holdfast_app
HOLDFAST_APP_PASSWORD=holdfast_app_local
