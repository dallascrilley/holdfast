{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "description": "An append-only decision ledger with a human approval gate: AI can propose, only a person can publish.",
  "license": "MIT",
  "author": "Dallas Crilley <dallas@dallascrilley.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "holdfast": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/holdfast.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/holdfast/issues"
  },
  "homepage": "https://github.com/dallascrilley/holdfast#readme",
  "keywords": [
    "append-only",
    "audit-log",
    "human-in-the-loop",
    "ai-safety",
    "postgres",
    "postgresql",
    "typescript",
    "ledger"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "tsx src/cli.ts migrate",
    "verify": "tsx src/cli.ts verify",
    "demo": "tsx src/cli.ts demo",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "tsx": "^4.23.11",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
